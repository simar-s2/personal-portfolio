---
// What I'm doing now, beside a Vancouver clock and the dot S.
import DotMark from './DotMark.astro';

// Ticks follow a rounded square, so the face fills the card like a watch.
const ticks = Array.from({ length: 60 }, (_, i) => {
  const a = (i * Math.PI) / 30;
  const s = Math.sin(a);
  const c = Math.cos(a);
  const reach = 81 / (Math.abs(s) ** 7 + Math.abs(c) ** 7) ** (1 / 7);
  const inner = reach - (i % 5 ? 6 : 15);
  const at = (r: number) => [(90 + r * s).toFixed(1), (90 - r * c).toFixed(1)];
  const [x1, y1] = at(inner);
  const [x2, y2] = at(reach);
  return { x1, y1, x2, y2, big: i % 5 === 0 };
});
---

<div class="widgets" data-reveal style="--i:1">
  <section class="now">
    <h2>Currently</h2>
    <p class="muted">
      Studying Math and Computer Science at Simon Fraser University, on the Dean's Honour Roll. I build
      backend systems and the cloud infrastructure they run on. Right now I'm finishing a site reliability
      internship at DarkVision and moving a 5,000+ user website to AWS with Develop for Good. In January I
      join Prof. Keval Vora's Parallel and Distributed Computing Lab at SFU to work on distributed graph
      mining systems.
    </p>
  </section>

  <div class="card clock" role="img" tabindex="0" aria-label="Current time in Vancouver, British Columbia">
    <span class="tip" aria-hidden="true">Vancouver, British Columbia</span>
    <svg viewBox="0 0 180 180" data-clock>
      <rect width="180" height="180" rx="24" class="face"></rect>
      {ticks.map((t) => <line x1={t.x1} y1={t.y1} x2={t.x2} y2={t.y2} class={t.big ? 'big' : 'tick'} />)}
      <text x="90" y="52">12</text>
      <text x="136" y="97.500">3</text>
      <text x="90" y="143">6</text>
      <text x="44" y="97.500">9</text>
      <g data-hand="h" style="transform:rotate(305deg)">
        <line class="hand" x1="90" y1="90" x2="90" y2="56" stroke-width="5.500"></line>
      </g>
      <g data-hand="m" style="transform:rotate(60deg)">
        <line class="hand" x1="90" y1="90" x2="90" y2="33" stroke-width="4"></line>
      </g>
      <g data-hand="s" style="transform:rotate(180deg)">
        <line class="sec-hand" x1="90" y1="104" x2="90" y2="24" stroke-width="1.200"></line>
      </g>
      <circle class="pin" cx="90" cy="90" r="3.200"></circle>
    </svg>
  </div>

  <DotMark />
</div>

<style>
  .widgets {
    display: grid;
    grid-template-columns: minmax(0, 1fr) 150px 150px;
    gap: 15px;
    align-items: start;
    margin-top: 30px;
  }
  .now {
    padding-right: 12px;
  }
  .now h2 {
    font-size: var(--text);
    font-weight: 500;
    letter-spacing: -0.028em;
    line-height: 1.5;
    margin-bottom: 6px;
  }
  /* The two small cards are a touch darker and more neutral than the other cards, as on the reference. */
  .widgets :global(.card) {
    background: rgb(23 23 23 / 0.95);
    border-color: rgb(255 255 255 / 0.1);
  }
  :global([data-theme='light']) .widgets :global(.card) {
    background: rgb(250 250 250 / 0.8);
    border-color: var(--line);
  }
  .clock {
    position: relative;
    outline-offset: 3px;
    display: grid;
    place-items: center;
    padding: 6px;
    aspect-ratio: 1;
  }
  .clock svg {
    width: 100%;
    max-height: 100%;
  }
  /* Where the clock is, shown on hover after a short wait, like the reference's tooltip. */
  .tip {
    position: absolute;
    left: 50%;
    bottom: calc(100% + 8px);
    z-index: 2;
    padding: 4px 10px;
    border: 1px solid var(--line);
    border-radius: 8px;
    background: var(--card);
    color: var(--muted);
    font-size: 12px;
    font-weight: 500;
    line-height: 16px;
    white-space: nowrap;
    box-shadow: 0 4px 12px rgb(0 0 0 / 0.4);
    pointer-events: none;
    opacity: 0;
    transform: translate(-50%, 3px) scale(0.97);
    transition:
      opacity 0.15s,
      transform 0.15s;
  }
  .clock:hover .tip,
  .clock:focus-visible .tip {
    opacity: 1;
    transform: translate(-50%, 0);
    transition-delay: 0.2s;
  }
  :global([data-theme='light']) .tip {
    box-shadow: 0 2px 8px rgb(0 0 0 / 0.06);
  }
  .face {
    fill: #0b0b0a;
  }
  .tick {
    stroke: #7d7a75;
    stroke-width: 1;
  }
  .big {
    stroke: #f4f2ef;
    stroke-width: 2.4;
  }
  text {
    fill: #f4f2ef;
    font-family: var(--sans);
    font-size: 21px;
    font-weight: 600;
    text-anchor: middle;
  }
  [data-hand] {
    transform-origin: 90px 90px;
  }
  .hand {
    stroke: #f4f2ef;
    stroke-linecap: round;
  }
  .sec-hand {
    stroke: var(--brand);
  }
  .pin {
    fill: var(--brand);
  }
  @media (max-width: 620px) {
    .widgets {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
    .now {
      grid-column: 1 / -1;
      padding-right: 0;
    }
  }
</style>

<script>
  // Vancouver time. The second hand sweeps smoothly, unless motion is turned down, and the
  // clock only runs while it is on screen.
  const card = document.querySelector<HTMLElement>('.clock');
  const hands = document.querySelectorAll<SVGGElement>('[data-hand]');
  const calm = matchMedia('(prefers-reduced-motion: reduce)').matches;
  const format = new Intl.DateTimeFormat('en-CA', {
    timeZone: 'America/Vancouver',
    year: 'numeric',
    month: 'numeric',
    day: 'numeric',
    hour: 'numeric',
    minute: 'numeric',
    second: 'numeric',
    hourCycle: 'h23',
  });

  // How far Vancouver's wall clock is from UTC, checked again every minute for daylight saving.
  let offset = 0;
  let synced = -Infinity;
  const sync = (now: number) => {
    const p = Object.fromEntries(format.formatToParts(now).map((x) => [x.type, +x.value]));
    const wall = Date.UTC(p.year!, p.month! - 1, p.day!, p.hour!, p.minute!, p.second!);
    offset = wall - (now - (now % 1000));
    synced = now;
  };

  const draw = () => {
    const now = Date.now();
    if (now - synced > 60_000) sync(now);
    const t = (now + offset) / 1000;
    const seconds = calm ? Math.floor(t % 60) : t % 60;
    const minutes = (t / 60) % 60;
    const hours = (t / 3600) % 12;
    const angles = { h: hours * 30, m: minutes * 6, s: seconds * 6 };
    for (const hand of hands) {
      hand.style.transform = `rotate(${angles[hand.dataset.hand as keyof typeof angles]}deg)`;
    }
  };

  let raf = 0;
  let timer = 0;
  const loop = () => {
    draw();
    raf = requestAnimationFrame(loop);
  };
  const run = (on: boolean) => {
    cancelAnimationFrame(raf);
    clearInterval(timer);
    if (!on) return;
    if (calm) timer = window.setInterval(draw, 1000);
    else raf = requestAnimationFrame(loop);
  };
  draw();
  if (card) new IntersectionObserver(([entry]) => run(!!entry?.isIntersecting)).observe(card);
</script>
