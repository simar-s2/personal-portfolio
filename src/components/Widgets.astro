---
// The row under the intro: a featured render, a Vancouver clock and a dot-matrix mark.
const base = import.meta.env.BASE_URL;

// The letter S, one string per row.
const glyph = ['.#####.', '##...##', '##.....', '.#####.', '.....##', '##...##', '.#####.'];
const cell = 15;
const mark = glyph.flatMap((row, y) =>
  [...row].flatMap((c, x) => (c === '#' ? [{ x: x * cell, y: y * cell }] : [])),
);

// Ticks follow a rounded square, so the face fills the card like a watch.
const ticks = Array.from({ length: 60 }, (_, i) => {
  const a = (i * Math.PI) / 30;
  const s = Math.sin(a);
  const c = Math.cos(a);
  const reach = 81 / (Math.abs(s) ** 7 + Math.abs(c) ** 7) ** (1 / 7);
  const inner = reach - (i % 5 ? 6 : 15);
  const at = (r: number) => [(90 + r * s).toFixed(1), (90 - r * c).toFixed(1)];
  const [x1, y1] = at(inner);
  const [x2, y2] = at(reach);
  return { x1, y1, x2, y2, big: i % 5 === 0 };
});
---

<div class="widgets" data-reveal style="--i:2">
  <a class="card feat" href={`${base}projects/quorumdb/`}>
    <div class="art">
      <img src={`${base}posters/quorumdb-thumb-dark.webp`} class="only-dark" alt="3D render of QuorumDB" width="320" height="320" />
      <img src={`${base}posters/quorumdb-thumb-light.webp`} class="only-light" alt="3D render of QuorumDB" width="320" height="320" loading="lazy" />
    </div>
    <div class="meta">
      <p class="k">Live 3D render</p>
      <p class="t">QuorumDB</p>
      <p class="s">Raft, from scratch in Go</p>
      <span class="go">
        <svg width="10" height="10" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linejoin="round" aria-hidden="true"><path d="M6 3.500v17l14-8.500z"></path></svg>
        Explore
      </span>
    </div>
  </a>

  <div class="card clock" role="img" aria-label="Current time in Vancouver">
    <svg viewBox="0 0 180 180" data-clock>
      <rect width="180" height="180" rx="24" class="face"></rect>
      {ticks.map((t) => <line x1={t.x1} y1={t.y1} x2={t.x2} y2={t.y2} class={t.big ? 'big' : 'tick'} />)}
      <text x="90" y="52">12</text>
      <text x="136" y="97.500">3</text>
      <text x="90" y="143">6</text>
      <text x="44" y="97.500">9</text>
      <g data-hand="h" style="transform:rotate(305deg)">
        <line class="hand" x1="90" y1="90" x2="90" y2="56" stroke-width="5.500"></line>
      </g>
      <g data-hand="m" style="transform:rotate(60deg)">
        <line class="hand" x1="90" y1="90" x2="90" y2="33" stroke-width="4"></line>
      </g>
      <g data-hand="s" style="transform:rotate(180deg)">
        <line class="sec-hand" x1="90" y1="104" x2="90" y2="24" stroke-width="1.200"></line>
      </g>
      <circle class="pin" cx="90" cy="90" r="3.200"></circle>
    </svg>
  </div>

  <div class="card markbox" aria-hidden="true">
    <svg viewBox={`-8 -8 ${7 * cell + 16} ${glyph.length * cell + 16}`}>
      <defs>
        <pattern id="dots" width="3.750" height="3.750" patternUnits="userSpaceOnUse">
          <rect x="0.400" y="0.400" width="2.950" height="2.950" rx="0.700" fill="var(--brand)"></rect>
        </pattern>
      </defs>
      {mark.map((m) => <rect x={m.x} y={m.y} width={cell} height={cell} fill="url(#dots)" />)}
    </svg>
  </div>
</div>

<style>
  .widgets {
    display: grid;
    grid-template-columns: minmax(0, 2.05fr) minmax(0, 1fr) minmax(0, 1fr);
    gap: 15px;
    margin-top: 33px;
  }
  .feat {
    display: flex;
    gap: 17px;
    padding: 14px;
    transition: border-color 0.18s;
  }
  .feat:hover {
    border-color: var(--line-2);
  }
  .art {
    flex: none;
    width: 148px;
    aspect-ratio: 1;
    border-radius: 9px;
    overflow: hidden;
    background: #000;
  }
  [data-theme='light'] .art {
    background: var(--soft);
  }
  .art img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  .meta {
    display: flex;
    flex-direction: column;
    justify-content: flex-end;
    min-width: 0;
  }
  .k {
    font-size: var(--tiny);
    color: var(--muted);
    line-height: 1.34;
  }
  .t {
    font-size: var(--text);
    font-weight: 500;
    line-height: 1.5;
    margin-top: 3px;
  }
  .s {
    color: var(--muted);
    font-size: var(--small);
    line-height: 1.43;
  }
  .go {
    display: inline-flex;
    align-items: center;
    align-self: flex-start;
    gap: 6px;
    margin-top: 9px;
    padding: 3px 11px 3px 9px;
    font-size: 12px;
    border-radius: 999px;
    background: var(--soft);
    white-space: nowrap;
  }
  .clock,
  .markbox {
    display: grid;
    place-items: center;
    padding: 7px;
  }
  .clock svg,
  .markbox svg {
    width: 100%;
    max-height: 100%;
  }
  .markbox svg {
    width: 80%;
  }
  .face {
    fill: #0b0b0a;
  }
  .tick {
    stroke: #7d7a75;
    stroke-width: 1;
  }
  .big {
    stroke: #f4f2ef;
    stroke-width: 2.4;
  }
  text {
    fill: #f4f2ef;
    font-family: var(--sans);
    font-size: 21px;
    font-weight: 600;
    text-anchor: middle;
  }
  [data-hand] {
    transform-origin: 90px 90px;
  }
  .hand {
    stroke: #f4f2ef;
    stroke-linecap: round;
  }
  .sec-hand {
    stroke: var(--brand);
  }
  .pin {
    fill: var(--brand);
  }
  @media (max-width: 620px) {
    .widgets {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
    .feat {
      grid-column: 1 / -1;
    }
    .clock,
    .markbox {
      aspect-ratio: 1;
    }
  }
</style>

<script>
  const hands = document.querySelectorAll<SVGGElement>('[data-hand]');
  const clock = new Intl.DateTimeFormat('en-CA', {
    timeZone: 'America/Vancouver',
    hour: 'numeric',
    minute: 'numeric',
    second: 'numeric',
    hourCycle: 'h23',
  });

  function tick() {
    const parts = Object.fromEntries(clock.formatToParts(new Date()).map((p) => [p.type, +p.value]));
    const seconds = parts.second!;
    const minutes = parts.minute! + seconds / 60;
    const hours = (parts.hour! % 12) + minutes / 60;
    const angles = { h: hours * 30, m: minutes * 6, s: seconds * 6 };
    for (const hand of hands) {
      hand.style.transform = `rotate(${angles[hand.dataset.hand as keyof typeof angles]}deg)`;
    }
  }

  tick();
  setInterval(() => document.hidden || tick(), 1000);
</script>
