---
// The row under the intro: a featured render, a Vancouver clock and a dot-matrix mark.
const base = import.meta.env.BASE_URL;

// The letter S, one string per row.
const glyph = ['.#####.', '##...##', '##.....', '.###...', '...###.', '.....##', '##...##', '.#####.'];
const cell = 15;
const mark = glyph.flatMap((row, y) =>
  [...row].flatMap((c, x) => (c === '#' ? [{ x: x * cell, y: y * cell }] : [])),
);
const ticks = Array.from({ length: 60 }, (_, i) => i);
---

<div class="widgets" data-reveal style="--i:2">
  <a class="card feat" href={`${base}projects/quorumdb/`}>
    <div class="art">
      <img
        src={`${base}posters/quorumdb-thumb-dark.webp`}
        class="only-dark"
        alt="3D render of QuorumDB's three replicas"
        width="320"
        height="320"
      />
      <img
        src={`${base}posters/quorumdb-thumb-light.webp`}
        class="only-light"
        alt=""
        width="320"
        height="320"
        loading="lazy"
      />
    </div>
    <div class="meta">
      <p class="eyebrow">Live 3D render</p>
      <p class="t">QuorumDB</p>
      <p class="s">Three replicas, one leader</p>
      <span class="go">▶ Crash the leader</span>
    </div>
  </a>

  <div class="card clock" role="img" aria-label="Current time in Vancouver">
    <svg viewBox="0 0 180 180" data-clock>
      {
        ticks.map((i) => (
          <line
            x1="90"
            y1={i % 5 ? 11 : 9}
            x2="90"
            y2={i % 5 ? 17 : 24}
            stroke-width={i % 5 ? 1 : 2.4}
            class={i % 5 ? 'tick' : 'hour-tick'}
            transform={`rotate(${i * 6} 90 90)`}
          />
        ))
      }
      <text x="90" y="49">12</text>
      <text x="139" y="97">3</text>
      <text x="90" y="145">6</text>
      <text x="41" y="97">9</text>
      <g data-hand="h" style="transform:rotate(305deg)">
        <line class="hand" x1="90" y1="90" x2="90" y2="56" stroke-width="5.5"></line>
      </g>
      <g data-hand="m" style="transform:rotate(60deg)">
        <line class="hand" x1="90" y1="90" x2="90" y2="35" stroke-width="4"></line>
      </g>
      <g data-hand="s" style="transform:rotate(180deg)">
        <line class="sec" x1="90" y1="104" x2="90" y2="26" stroke-width="1.2"></line>
      </g>
      <circle class="pin" cx="90" cy="90" r="3.2"></circle>
    </svg>
  </div>

  <div class="card markbox" aria-hidden="true">
    <svg viewBox={`-8 -8 ${7 * cell + 16} ${8 * cell + 16}`}>
      <defs>
        <pattern id="dots" width="3.75" height="3.75" patternUnits="userSpaceOnUse">
          <rect x="0.4" y="0.4" width="2.95" height="2.95" rx="0.7" fill="var(--brand)"></rect>
        </pattern>
      </defs>
      {mark.map((m) => <rect x={m.x} y={m.y} width={cell} height={cell} fill="url(#dots)" />)}
    </svg>
  </div>
</div>

<style>
  .widgets {
    display: grid;
    grid-template-columns: minmax(0, 2.1fr) minmax(0, 1fr) minmax(0, 1fr);
    gap: 12px;
    margin-top: 40px;
  }
  .feat {
    display: flex;
    gap: 16px;
    padding: 12px;
    min-height: 180px;
    transition: border-color 0.18s;
  }
  .feat:hover {
    border-color: var(--line-2);
  }
  .art {
    flex: none;
    width: 154px;
    aspect-ratio: 1;
    border-radius: 9px;
    overflow: hidden;
    background: var(--bg);
    view-transition-name: quorumdb-render;
  }
  .art img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  .meta {
    display: flex;
    flex-direction: column;
    justify-content: flex-end;
    min-width: 0;
    padding-bottom: 4px;
  }
  .t {
    font-size: 15px;
    font-weight: 500;
    margin-top: 2px;
  }
  .s {
    color: var(--muted);
    font-size: 13px;
  }
  .go {
    align-self: flex-start;
    margin-top: 10px;
    padding: 3px 11px;
    font-size: 12px;
    border-radius: 999px;
    background: var(--soft);
    white-space: nowrap;
  }
  .clock,
  .markbox {
    display: grid;
    place-items: center;
    padding: 10px;
    aspect-ratio: 1;
  }
  .clock svg,
  .markbox svg {
    width: 100%;
    height: 100%;
  }
  .markbox svg {
    width: 82%;
  }
  .tick {
    stroke: var(--faint);
  }
  .hour-tick {
    stroke: var(--fg);
  }
  text {
    fill: var(--fg);
    font-family: var(--sans);
    font-size: 21px;
    font-weight: 600;
    text-anchor: middle;
  }
  [data-hand] {
    transform-origin: 90px 90px;
  }
  .hand {
    stroke: var(--fg);
    stroke-linecap: round;
  }
  .sec {
    stroke: var(--brand);
  }
  .pin {
    fill: var(--brand);
  }
  @media (max-width: 620px) {
    .widgets {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
    .feat {
      grid-column: 1 / -1;
    }
  }
</style>

<script>
  const hands = document.querySelectorAll<SVGGElement>('[data-hand]');
  const clock = new Intl.DateTimeFormat('en-CA', {
    timeZone: 'America/Vancouver',
    hour: 'numeric',
    minute: 'numeric',
    second: 'numeric',
    hourCycle: 'h23',
  });

  function tick() {
    const parts = Object.fromEntries(clock.formatToParts(new Date()).map((p) => [p.type, +p.value]));
    const seconds = parts.second!;
    const minutes = parts.minute! + seconds / 60;
    const hours = (parts.hour! % 12) + minutes / 60;
    const angles = { h: hours * 30, m: minutes * 6, s: seconds * 6 };
    for (const hand of hands) {
      hand.style.transform = `rotate(${angles[hand.dataset.hand as keyof typeof angles]}deg)`;
    }
  }

  tick();
  setInterval(() => document.hidden || tick(), 1000);
</script>
