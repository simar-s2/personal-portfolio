---
import { existsSync } from 'node:fs';
import type { RScene } from '../render/types';

interface Props {
  id: string;
  title: string;
  scene: RScene;
  repo?: string;
}

const { id, title, scene, repo } = Astro.props;
const base = import.meta.env.BASE_URL;
const hasPoster = existsSync(`public/posters/${id}-dark.webp`);
const parts = scene.nodes.map((n) => n.label).join(', ');
---

<figure class="render card" data-render data-repo={repo} id="render">
  <div class="stage" style={`view-transition-name:${id}-render`}>
    {
      hasPoster && (
        <>
          <img class="poster only-dark" src={`${base}posters/${id}-dark.webp`} alt="" width="1600" height="920" />
          <img class="poster only-light" src={`${base}posters/${id}-light.webp`} alt="" width="1600" height="920" />
        </>
      )
    }
    <canvas tabindex="0" role="img" aria-label={`3D architecture of ${title}. Parts: ${parts}.`}></canvas>
    <div class="labels"></div>
    <p class="hint">Drag to rotate · Click a block</p>
  </div>
  <figcaption class="panel">
    <div class="cap" aria-live="polite">
      <p class="cap-title" hidden></p>
      <p class="cap-text">{scene.caption}</p>
      <a class="cap-link" target="_blank" rel="noopener" hidden></a>
    </div>
    {
      scene.steps && (
        <div class="ctrl">
          <button class="cta" type="button">
            ▶ {scene.cta ?? 'Walk through it'}
          </button>
          <div class="nav" hidden>
            <button class="ib prev" type="button" aria-label="Previous step">←</button>
            <span class="count mono" />
            <button class="ib next" type="button" aria-label="Next step">→</button>
            <button class="ib pause" type="button" aria-label="Pause">❚❚</button>
            <button class="ib close" type="button" aria-label="Exit the walkthrough">✕</button>
          </div>
        </div>
      )
    }
  </figcaption>
  <script type="application/json" data-scene set:html={JSON.stringify(scene)} />
</figure>

<script>
  // The renderer loads only when the figure is close to the screen.
  const root = document.querySelector<HTMLElement>('[data-render]');
  if (root) {
    new IntersectionObserver(
      ([entry], observer) => {
        if (!entry?.isIntersecting) return;
        observer.disconnect();
        import('../render/index').then(({ mount }) => mount(root));
      },
      { rootMargin: '300px' },
    ).observe(root);
  }
</script>

<style is:global>
  .render {
    width: min(1060px, calc(100vw - 32px));
    margin-left: calc(50% - min(530px, 50vw - 16px));
    overflow: hidden;
  }
  .stage {
    position: relative;
    aspect-ratio: 1600 / 920;
    overflow: hidden;
  }
  .stage canvas {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    touch-action: pan-y;
    cursor: grab;
    opacity: 0;
    outline-offset: -3px;
    transition: opacity 0.35s;
  }
  .stage canvas:active {
    cursor: grabbing;
  }
  .ready .stage canvas {
    opacity: 1;
  }
  .poster {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: opacity 0.35s;
  }
  .ready .poster {
    opacity: 0;
    pointer-events: none;
  }
  .labels {
    position: absolute;
    inset: 0;
    pointer-events: none;
    overflow: hidden;
    opacity: 0;
    transition: opacity 0.35s;
  }
  .ready .labels {
    opacity: 1;
  }
  .rl {
    position: absolute;
    left: 0;
    top: 0;
    padding: 3px 7px 4px;
    pointer-events: auto;
    white-space: nowrap;
    text-align: left;
    font-family: var(--mono);
    font-size: 11px;
    line-height: 1.3;
    color: var(--fg);
    background: color-mix(in srgb, var(--card) 86%, transparent);
    border: 1px solid var(--line);
    border-radius: 7px;
    will-change: transform;
    transition: opacity 0.22s, border-color 0.22s;
  }
  .rl:hover,
  .rl:focus-visible {
    border-color: var(--line-2);
  }
  .rl-sub {
    display: block;
    color: var(--muted);
    font-size: 10px;
  }
  .rl-tag:not(:empty) {
    margin-left: 6px;
    color: var(--brand-fg);
  }
  .rl.dim {
    opacity: 0.42;
  }
  .rl.on {
    border-color: var(--brand);
  }
  .rl.down .rl-name {
    color: var(--faint);
    text-decoration: line-through;
  }
  .rl.behind {
    opacity: 0.14;
    pointer-events: none;
  }
  .hint {
    position: absolute;
    left: 14px;
    top: 11px;
    font-family: var(--mono);
    font-size: 10.5px;
    color: var(--faint);
    pointer-events: none;
    transition: opacity 0.3s;
  }
  .touched .hint {
    opacity: 0;
  }
  .panel {
    display: flex;
    justify-content: space-between;
    align-items: flex-start;
    gap: 20px;
    min-height: 88px;
    padding: 14px 16px 15px;
    border-top: 1px solid var(--line);
  }
  .cap {
    max-width: 68ch;
    font-size: 13.5px;
    line-height: 1.55;
  }
  .cap-title {
    font-weight: 500;
  }
  .cap-text {
    color: var(--muted);
  }
  .cap-link {
    display: inline-block;
    margin-top: 3px;
    font-family: var(--mono);
    font-size: 11.5px;
    color: var(--brand-fg);
    overflow-wrap: anywhere;
  }
  .ctrl {
    flex: none;
  }
  .cta {
    height: 32px;
    padding: 0 14px;
    border-radius: 999px;
    background: var(--fg);
    color: var(--bg);
    font-size: 12.5px;
    font-weight: 500;
    white-space: nowrap;
    transition: opacity 0.18s, transform 0.18s var(--ease);
  }
  .cta:hover {
    opacity: 0.86;
  }
  .cta:active {
    transform: scale(0.97);
  }
  .nav {
    display: flex;
    align-items: center;
    gap: 4px;
  }
  .nav[hidden],
  .cta[hidden] {
    display: none;
  }
  .ib {
    width: 28px;
    height: 28px;
    border-radius: 8px;
    border: 1px solid var(--line);
    font-size: 12px;
    color: var(--muted);
    transition: color 0.18s, border-color 0.18s;
  }
  .ib:hover {
    color: var(--fg);
    border-color: var(--line-2);
  }
  .count {
    min-width: 44px;
    text-align: center;
    font-size: 11.5px;
    color: var(--muted);
  }
  @media (max-width: 720px) {
    .stage {
      aspect-ratio: 1 / 1.02;
    }
    .rl {
      font-size: 10px;
      padding: 2px 5px 3px;
    }
    .rl-sub {
      display: none;
    }
    .panel {
      flex-direction: column;
      gap: 12px;
      min-height: 138px;
    }
    .cta {
      width: 100%;
    }
    .poster {
      object-fit: cover;
    }
  }
</style>
