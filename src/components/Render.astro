---
import { existsSync } from 'node:fs';
import Icon from './Icon.astro';
import type { REntry } from '../render/types';

interface Props {
  entries: REntry[];
}

const { entries } = Astro.props;
const first = entries[0]!;
const base = import.meta.env.BASE_URL;
const hasPoster = existsSync(`public/posters/${first.id}-dark.webp`);
const parts = first.scene.nodes.map((n) => n.label).join(', ');
const hasTabs = entries.length > 1;
---

<figure class="render card" data-render id="render">
  {
    hasTabs && (
      <div class="tabs" role="tablist" aria-label="Choose a project">
        {entries.map((e, i) => (
          <button class="tab" type="button" role="tab" aria-selected={i === 0 ? 'true' : 'false'} data-tab>
            {e.title}
            <i class="tab-bar" />
          </button>
        ))}
      </div>
    )
  }
  <div class="stage" style={`view-transition-name:${first.id}-render`}>
    {
      hasPoster && (
        <>
          <img class="poster only-dark" src={`${base}posters/${first.id}-dark.webp`} alt="" width="1522" height="1014" fetchpriority="high" />
          <img class="poster only-light" src={`${base}posters/${first.id}-light.webp`} alt="" width="1522" height="1014" />
        </>
      )
    }
    <canvas tabindex="0" role="img" aria-label={`3D architecture of ${first.title}. Parts: ${parts}.`}></canvas>
    <div class="labels"></div>
    <p class="hint">Drag to rotate · Click a block</p>
  </div>
  <figcaption class="panel">
    <div class="cap" aria-live="polite">
      <p class="cap-title" hidden></p>
      <p class="cap-text">{first.scene.caption}</p>
      <a class="cap-link" href={first.repo ?? '#render'} target="_blank" rel="noopener" hidden></a>
    </div>
    <div class="ctrl">
      <div class="rest">
        <button class="cta" type="button" data-umami-event="Start walkthrough" data-umami-event-project={first.id}>
          ▶ {first.scene.cta ?? 'Walk through it'}
        </button>
        {
          hasTabs && (
            <>
              <a class="ghost" href={first.href} data-case-link data-umami-event="Open case study" data-umami-event-project={first.id}>
                Case study
              </a>
              {first.repo && (
                <a class="ghost icon" href={first.repo} target="_blank" rel="noopener" aria-label="Source on GitHub" data-repo-link data-umami-event="Open GitHub" data-umami-event-project={first.id}>
                  <Icon name="GitHub" size={15} />
                </a>
              )}
            </>
          )
        }
      </div>
      <div class="nav" hidden>
        <button class="ib step-prev" type="button" aria-label="Previous step">←</button>
        <span class="count"></span>
        <button class="ib step-next" type="button" aria-label="Next step">→</button>
        <button class="ib step-toggle" type="button" aria-label="Pause">❚❚</button>
        <button class="ib step-exit" type="button" aria-label="Exit the walkthrough">✕</button>
      </div>
    </div>
  </figcaption>
  <script type="application/json" data-scenes set:html={JSON.stringify(entries)} />
</figure>

<script>
  // The renderer loads only when the figure is close to the screen.
  const root = document.querySelector<HTMLElement>('[data-render]');
  if (root) {
    new IntersectionObserver(
      ([entry], observer) => {
        if (!entry?.isIntersecting) return;
        observer.disconnect();
        import('../render/index').then(({ mount }) => mount(root));
      },
      { rootMargin: '300px' },
    ).observe(root);
  }
</script>

<style is:global>
  /* Lines up with the text and every other section. */
  .render {
    overflow: hidden;
  }
  .tabs {
    display: flex;
    gap: 2px;
    padding: 7px;
    overflow-x: auto;
    scrollbar-width: none;
    border-bottom: 1px solid var(--line);
  }
  .tab {
    position: relative;
    flex: none;
    height: 32px;
    padding: 0 12px;
    overflow: hidden;
    border-radius: 8px;
    font-size: 14px;
    color: var(--muted);
    transition: color 0.18s, background 0.18s;
  }
  .tab:hover {
    color: var(--fg);
  }
  .tab[aria-selected='true'] {
    color: var(--fg);
    background: var(--soft);
  }
  .tab-bar {
    position: absolute;
    left: 0;
    right: 0;
    bottom: 0;
    height: 2px;
    background: var(--brand);
    transform: scaleX(0);
    transform-origin: left;
  }
  .swapping canvas,
  .swapping .labels {
    opacity: 0 !important;
    transition: opacity 0.16s;
  }
  .stage {
    position: relative;
    aspect-ratio: 3 / 2;
    width: 100%;
    overflow: hidden;
    background: #000;
  }
  [data-theme='light'] .stage {
    background: var(--card);
  }
  .stage canvas {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    touch-action: pan-y;
    cursor: grab;
    opacity: 0;
    outline-offset: -3px;
    transition: opacity 0.35s;
  }
  .stage canvas:active {
    cursor: grabbing;
  }
  .ready .stage canvas {
    opacity: 1;
  }
  .poster {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: opacity 0.35s;
  }
  .ready .poster {
    opacity: 0;
    pointer-events: none;
  }
  .labels {
    position: absolute;
    inset: 0;
    pointer-events: none;
    overflow: hidden;
    opacity: 0;
    transition: opacity 0.35s;
  }
  .ready .labels {
    opacity: 1;
  }
  .rl {
    position: absolute;
    left: 0;
    top: 0;
    padding: 2px 8px 3px;
    pointer-events: auto;
    white-space: nowrap;
    text-align: left;
    font-size: 12.5px;
    font-weight: 500;
    line-height: 1.34;
    color: var(--fg);
    background: color-mix(in srgb, var(--bg) 82%, transparent);
    border: 1px solid var(--line);
    border-radius: 7px;
    will-change: transform;
    transition: opacity 0.22s, border-color 0.22s;
  }
  .rl:hover,
  .rl:focus-visible {
    border-color: var(--line-2);
  }
  .rl-sub {
    display: none;
    color: var(--muted);
    font-size: 11.5px;
    font-weight: 400;
  }
  .rl.on .rl-sub,
  .rl:hover .rl-sub,
  .rl:focus-visible .rl-sub {
    display: block;
  }
  .rl-tag:not(:empty) {
    margin-left: 5px;
    color: var(--brand);
  }
  .rl.dim {
    opacity: 0.42;
  }
  .rl.on {
    border-color: var(--brand);
  }
  .rl.down .rl-name {
    color: var(--muted);
    text-decoration: line-through;
  }
  .rl.behind {
    opacity: 0.14;
    pointer-events: none;
  }
  .rz {
    position: absolute;
    left: 0;
    top: 0;
    font-size: 11.5px;
    color: var(--faint);
    white-space: nowrap;
    will-change: transform;
  }
  .hint {
    position: absolute;
    left: 13px;
    top: 10px;
    font-size: var(--tiny);
    color: var(--faint);
    pointer-events: none;
    transition: opacity 0.3s;
  }
  .touched .hint {
    opacity: 0;
  }
  .panel {
    display: flex;
    justify-content: space-between;
    align-items: flex-start;
    gap: 18px;
    min-height: 92px;
    padding: 12px 14px 13px;
    border-top: 1px solid var(--line);
  }
  .cap {
    font-size: var(--small);
    line-height: 1.5;
  }
  .cap-title {
    font-weight: 500;
  }
  .cap-text {
    color: var(--muted);
  }
  .cap-link {
    display: inline-block;
    margin-top: 3px;
    font-size: var(--tiny);
    color: var(--muted);
    text-decoration: underline;
    text-underline-offset: 3px;
    overflow-wrap: anywhere;
  }
  .cap-link:hover {
    color: var(--fg);
  }
  .cap-link[hidden] {
    display: none;
  }
  .ctrl {
    flex: none;
  }
  .rest {
    display: flex;
    align-items: center;
    flex-wrap: wrap;
    gap: 6px;
  }
  .rest[hidden],
  .ghost[hidden] {
    display: none;
  }
  .ghost {
    display: inline-grid;
    place-items: center;
    height: 31px;
    padding: 0 12px;
    border: 1px solid var(--line);
    border-radius: 999px;
    font-size: 13.5px;
    white-space: nowrap;
    color: var(--muted);
    transition: color 0.18s, border-color 0.18s;
  }
  .ghost.icon {
    width: 31px;
    padding: 0;
  }
  .ghost:hover {
    color: var(--fg);
    border-color: var(--line-2);
  }
  .cta {
    height: 31px;
    padding: 0 13px;
    border-radius: 999px;
    background: var(--fg);
    color: var(--bg);
    font-size: 13.5px;
    font-weight: 500;
    white-space: nowrap;
    transition: opacity 0.18s, transform 0.18s var(--ease);
  }
  .cta:hover {
    opacity: 0.8;
  }
  .cta:active {
    transform: scale(0.97);
  }
  .nav {
    display: flex;
    align-items: center;
    gap: 3px;
  }
  .nav[hidden] {
    display: none;
  }
  .ib {
    width: 26px;
    height: 26px;
    border-radius: 999px;
    font-size: 12px;
    color: var(--muted);
    transition: color 0.18s, background 0.18s;
  }
  .ib:hover {
    color: var(--fg);
    background: var(--soft);
  }
  .count {
    min-width: 38px;
    text-align: center;
    font-size: var(--tiny);
    font-variant-numeric: tabular-nums;
    color: var(--muted);
  }
  @media (max-width: 620px) {
    .stage {
      aspect-ratio: 1 / 1.02;
    }
    .rl {
      pointer-events: none;
      font-size: 11px;
      padding: 1px 5px 2px;
    }
    .rl.on .rl-sub {
      display: none;
    }
    .panel {
      flex-direction: column;
      gap: 10px;
      min-height: 132px;
    }
  }
</style>
