---
import { lessons } from '../data/site';

const base = import.meta.env.BASE_URL;
---

<section class="sec" id="lessons" data-reveal>
  <h2>Things I learned</h2>
  <ul class="list">
    {
      lessons.map((l) => (
        <li>
          <a href={`${base}projects/${l.slug}/#things-i-learned`}>
            <p class="title">{l.title}</p>
            <p class="from">{l.from}</p>
          </a>
        </li>
      ))
    }
  </ul>
</section>

<style>
  .list {
    display: grid;
    gap: 18px;
  }
  a {
    display: block;
    transition: opacity 0.18s;
  }
  a:hover {
    opacity: 0.7;
  }
  .title {
    line-height: 1.5;
  }
  .from {
    color: var(--muted);
    font-size: var(--small);
    line-height: 1.43;
    margin-top: 1px;
  }
</style>
