---
import { site } from '../data/site';
---

<footer class="foot">
  <nav class="foot-links" aria-label="Elsewhere">
    <a class="link" href={site.github.url} target="_blank" rel="noopener">GitHub</a>
    <a class="link" href={site.linkedin.url} target="_blank" rel="noopener">LinkedIn</a>
    <a class="link" href={`mailto:${site.email}`}>Email</a>
  </nav>
  <p>© {new Date().getFullYear()} {site.name}</p>
</footer>

<style>
  .foot {
    margin-top: 72px;
    text-align: center;
    color: var(--faint);
    font-family: var(--mono);
    font-size: 11.5px;
  }
  .foot-links {
    display: flex;
    justify-content: center;
    flex-wrap: wrap;
    gap: 16px;
    margin-bottom: 12px;
    color: var(--muted);
  }
</style>
