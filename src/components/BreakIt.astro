---
// Each card opens a render straight into its walkthrough.
const base = import.meta.env.BASE_URL;
const cards = [
  { id: 'quorumdb', title: 'Crash the leader', sub: 'Watch QuorumDB elect a new one.' },
  { id: 'cluster-scheduler', title: 'Freeze the leader', sub: 'Then wake it up too late.' },
  { id: 'facemesh', title: 'Clean up a scan', sub: 'Noise in, a tidy mesh out.' },
];
---

<section class="sec" id="break-it" data-reveal>
  <h2>Break it</h2>
  <div class="cards">
    {
      cards.map((c) => (
        <a class="card c" href={`${base}projects/${c.id}/#play`}>
          <p class="t">{c.title}</p>
          <p class="s">{c.sub}</p>
        </a>
      ))
    }
  </div>
</section>

<style>
  .cards {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 15px;
  }
  .c {
    display: block;
    padding: 11px 12px 12px;
    transition: border-color 0.18s;
  }
  .c:hover {
    border-color: var(--line-2);
  }
  .t {
    font-size: var(--small);
    font-weight: 500;
    line-height: 1.43;
  }
  .s {
    margin-top: 2px;
    font-size: var(--tiny);
    line-height: 1.34;
    color: var(--muted);
  }
  @media (max-width: 620px) {
    .cards {
      grid-template-columns: minmax(0, 1fr);
    }
  }
</style>
