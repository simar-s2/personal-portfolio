---
import Ph from './Ph.astro';
import { experience } from '../data/site';
---

<section class="sec" id="experience" data-reveal>
  <h2>Experience</h2>
  <ul class="jobs">
    {
      experience.map((job) => (
        <li>
          <div class="row">
            <p class="what">
              <Ph text={job.title} />
              <span class="muted"> · </span>
              {job.url ? (
                <a href={job.url} target="_blank" rel="noopener">
                  {job.org}
                </a>
              ) : (
                job.org
              )}
            </p>
            {job.note && <p class="side">{job.note}</p>}
          </div>
          <p class="when">{job.when}</p>
          <p class="text">{job.text}</p>
        </li>
      ))
    }
  </ul>
</section>

<style>
  .jobs {
    display: grid;
    gap: 22px;
  }
  .row {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    gap: 0 16px;
  }
  .what {
    line-height: 1.5;
  }
  .what a {
    text-decoration: underline;
    text-decoration-color: var(--line-2);
    text-underline-offset: 4px;
    transition: text-decoration-color 0.18s;
  }
  .what a:hover {
    text-decoration-color: currentColor;
  }
  .side,
  .when {
    color: var(--muted);
    font-size: var(--small);
    line-height: 22px;
  }
  .when {
    line-height: 1.43;
    margin-top: 2px;
  }
  .text {
    color: var(--muted);
    font-size: var(--small);
    line-height: 1.55;
    margin-top: 5px;
  }
</style>
