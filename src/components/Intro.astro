---
import Icon from './Icon.astro';
import Ph from './Ph.astro';
import { site } from '../data/site';
---

<header data-reveal="hero">
  <h1 class="name">{site.name}</h1>
  <p class="role">{site.tagline}</p>
  <div class="contact">
    <a href={`mailto:${site.email}`} data-copy={site.email} data-umami-event="Copy email">
      <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true">
        <rect x="9" y="9" width="12" height="12" rx="2"></rect>
        <path d="M5 15H4a1 1 0 0 1-1-1V4a1 1 0 0 1 1-1h10a1 1 0 0 1 1 1v1"></path>
      </svg>
      <span data-copy-label>{site.email}</span>
    </a>
    <a href={site.github.url} target="_blank" rel="noopener" data-umami-event="Open GitHub profile">
      <Icon name="GitHub" />
      @{site.github.handle}
    </a>
    <a href={site.linkedin.url} target="_blank" rel="noopener" data-umami-event="Open LinkedIn">
      <Icon name="LinkedIn" />
      {site.linkedin.handle}
    </a>
    <span><Ph text={site.resume} /></span>
  </div>
</header>

<style>
  .name {
    font-size: 21px;
    font-weight: 500;
    letter-spacing: -0.025em;
    line-height: 1.4;
  }
  .role {
    margin-top: 4px;
    color: var(--muted);
    font-weight: 500;
    line-height: 1.5;
  }
  .contact {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 4px 19px;
    margin-top: 12px;
    color: var(--muted);
  }
  .contact a {
    display: inline-flex;
    align-items: center;
    gap: 7px;
    transition: color 0.18s;
  }
  .contact a:hover {
    color: var(--fg);
  }
</style>

<script>
  // Clicking the email copies it, since many people don't have a mail app set up.
  for (const link of document.querySelectorAll<HTMLAnchorElement>('[data-copy]')) {
    const label = link.querySelector('[data-copy-label]')!;
    link.addEventListener('click', async (event) => {
      if (!navigator.clipboard) return;
      event.preventDefault();
      await navigator.clipboard.writeText(link.dataset.copy!);
      label.textContent = 'Copied';
      setTimeout(() => (label.textContent = link.dataset.copy!), 1400);
    });
  }
</script>
