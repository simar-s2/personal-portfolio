---
import Icon from './Icon.astro';
import Ph from './Ph.astro';
import { site } from '../data/site';
---

<header data-reveal="hero">
  <h1 class="name">{site.name}</h1>
  <p class="role">{site.role}</p>
</header>

<section class="now" data-reveal style="--i:1">
  <h2>Currently</h2>
  <p class="muted">
    Studying Math and Computer Science at Simon Fraser University. I build backend systems and the
    cloud infrastructure they run on. Right now I'm finishing an internship at DarkVision and moving a
    5,000+ user website to AWS with Develop for Good. In January I join SFU's Parallel and Distributed
    Computing Lab to work on distributed graph mining systems.
  </p>
  <div class="contact">
    <a href={`mailto:${site.email}`} data-copy={site.email}>
      <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true">
        <rect x="9" y="9" width="12" height="12" rx="2"></rect>
        <path d="M5 15H4a1 1 0 0 1-1-1V4a1 1 0 0 1 1-1h10a1 1 0 0 1 1 1v1"></path>
      </svg>
      <span data-copy-label>{site.email}</span>
    </a>
    <a href={site.github.url} target="_blank" rel="noopener" aria-label="GitHub profile">
      <Icon name="GitHub" />
      @{site.github.handle}
    </a>
    <a href={site.linkedin.url} target="_blank" rel="noopener" aria-label="LinkedIn profile">
      <Icon name="LinkedIn" />
      {site.linkedin.handle}
    </a>
    <span><Ph text={site.resume} /></span>
  </div>
</section>

<style>
  .name {
    font-size: 18.68px;
    font-weight: 500;
    letter-spacing: -0.025em;
    line-height: 1.4;
  }
  .role {
    margin-top: 4px;
    color: var(--muted);
    font-weight: 500;
    line-height: 1.5;
  }
  .now {
    margin-top: 30px;
  }
  .now h2 {
    font-size: var(--text);
    font-weight: 500;
    letter-spacing: -0.028em;
    line-height: 1.5;
    margin-bottom: 8px;
  }
  .contact {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 4px 19px;
    margin-top: 18px;
    color: var(--muted);
  }
  .contact a {
    display: inline-flex;
    align-items: center;
    gap: 7px;
    transition: color 0.18s;
  }
  .contact a:hover {
    color: var(--fg);
  }
</style>

<script>
  // Clicking the email copies it, since many people don't have a mail app set up.
  for (const link of document.querySelectorAll<HTMLAnchorElement>('[data-copy]')) {
    const label = link.querySelector('[data-copy-label]')!;
    link.addEventListener('click', async (event) => {
      if (!navigator.clipboard) return;
      event.preventDefault();
      await navigator.clipboard.writeText(link.dataset.copy!);
      label.textContent = 'Copied';
      setTimeout(() => (label.textContent = link.dataset.copy!), 1400);
    });
  }
</script>
