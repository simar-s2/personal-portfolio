---
// The end of every page: a quote on the home page, and the links everywhere.
import { site } from '../data/site';

interface Props {
  full?: boolean;
}

const { full = false } = Astro.props;
---

{
  full && (
    <figure class="quote" data-reveal>
      <blockquote>"Success is not final, failure is not fatal: It is the courage to continue that counts."</blockquote>
      <figcaption>— Winston S. Churchill</figcaption>
    </figure>
  )
}

<nav class="out" aria-label="Elsewhere" data-reveal>
  <a href={site.linkedin.url} target="_blank" rel="noopener">LinkedIn</a>
  <a href={`mailto:${site.email}`}>Gmail</a>
  <a href={site.github.url} target="_blank" rel="noopener">GitHub</a>
</nav>

<style>
  .quote {
    margin-top: 90px;
    text-align: center;
    font-family: var(--mono);
  }
  .quote blockquote {
    margin: 0;
    font-size: clamp(15px, 2.6vw, 18px);
    line-height: 1.625;
  }
  .quote figcaption {
    margin-top: 8px;
    font-size: 13px;
    color: var(--muted);
  }
  .out {
    display: flex;
    justify-content: center;
    flex-wrap: wrap;
    gap: 16px;
    margin-top: 60px;
    font-family: var(--mono);
    font-size: 12.25px;
    letter-spacing: 0.02em;
    color: var(--muted);
  }
  .out a {
    text-decoration: underline;
    text-underline-offset: 4px;
    transition: color 0.18s;
  }
  .out a:hover {
    color: var(--fg);
  }
</style>
