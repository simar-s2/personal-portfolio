---
import activity from '../data/activity.json';
import { site } from '../data/site';

const cell = 11;
const size = 9;
const months = ['Jan', 'Feb', 'Mar', 'Apr', 'May', 'Jun', 'Jul', 'Aug', 'Sep', 'Oct', 'Nov', 'Dec'];

// One path per shade keeps a year of squares down to a few short strings.
const shades: string[] = ['', '', '', '', ''];
const labels: { x: number; text: string }[] = [];
let lastMonth = -1;
activity.weeks.forEach((week, x) => {
  week.days.forEach((level, i) => {
    const y = week.firstWeekday + i;
    shades[level] += `M${x * cell} ${y * cell}h${size}v${size}h-${size}z`;
  });
  const month = new Date(`${week.start}T00:00:00Z`).getUTCMonth();
  if (month !== lastMonth && x < activity.weeks.length - 2) {
    if (lastMonth !== -1 || new Date(`${week.start}T00:00:00Z`).getUTCDate() < 15) {
      labels.push({ x: x * cell, text: months[month]! });
    }
    lastMonth = month;
  }
});
const width = activity.weeks.length * cell - (cell - size);
const height = 7 * cell - (cell - size);
---

<section class="sec" id="activity" data-reveal>
  <h2>Activity</h2>
  <a class="card box" href={site.github.url} target="_blank" rel="noopener">
    <div class="scroll">
      <svg viewBox={`0 -16 ${width} ${height + 16}`} aria-hidden="true">
        {labels.map((l) => <text x={l.x} y="-6">{l.text}</text>)}
        {shades.map((d, i) => <path class={`s${i}`} d={d} />)}
      </svg>
    </div>
    <div class="foot">
      <span>{activity.total} contributions in the last year</span>
      <span class="legend">
        Less
        {[0, 1, 2, 3, 4].map((i) => <i class={`s${i}`} />)}
        More
      </span>
    </div>
  </a>
</section>

<style>
  .box {
    display: block;
    padding: 14px 15px 12px;
    transition: border-color 0.18s;
  }
  .box:hover {
    border-color: var(--line-2);
  }
  .scroll {
    overflow-x: auto;
  }
  svg {
    width: 100%;
    min-width: 560px;
    height: auto;
  }
  text {
    font-size: 9px;
    fill: var(--muted);
  }
  path {
    stroke-width: 1;
    stroke-linejoin: round;
  }
  .s0 {
    --c: color-mix(in srgb, var(--fg) 7%, transparent);
  }
  .s1 {
    --c: color-mix(in srgb, var(--fg) 24%, transparent);
  }
  .s2 {
    --c: color-mix(in srgb, var(--fg) 42%, transparent);
  }
  .s3 {
    --c: color-mix(in srgb, var(--fg) 66%, transparent);
  }
  .s4 {
    --c: var(--fg);
  }
  path[class] {
    fill: var(--c);
  }
  .foot {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    gap: 2px 16px;
    margin-top: 10px;
    font-size: 13px;
    color: var(--fg);
  }
  .legend {
    display: inline-flex;
    align-items: center;
    gap: 3px;
    color: var(--muted);
  }
  .legend i {
    width: 9px;
    height: 9px;
    border-radius: 2px;
    background: var(--c);
  }
  .legend i:first-of-type {
    margin-left: 5px;
  }
  .legend i:last-of-type {
    margin-right: 5px;
  }
</style>
