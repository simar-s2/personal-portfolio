---
const base = import.meta.env.BASE_URL;
const tiles = [
  { id: 'cluster-scheduler', title: 'cluster-scheduler' },
  { id: 'kbsync', title: 'kbsync' },
  { id: 'facemesh', title: 'FaceMesh' },
];
---

<section class="sec" id="renders" data-reveal>
  <h2>Renders</h2>
  <div class="tiles">
    {
      tiles.map((t) => (
        <a class="card tile" href={`${base}projects/${t.id}/`}>
          <div class="art">
            <img class="only-dark" src={`${base}posters/${t.id}-tile-dark.webp`} alt={`3D render of ${t.title}`} width="480" height="300" loading="lazy" />
            <img class="only-light" src={`${base}posters/${t.id}-tile-light.webp`} alt={`3D render of ${t.title}`} width="480" height="300" loading="lazy" />
          </div>
          <p>{t.title}</p>
        </a>
      ))
    }
  </div>
</section>

<style>
  .tiles {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 15px;
  }
  .tile {
    display: block;
    padding: 5px 5px 7px;
    transition: border-color 0.18s;
  }
  .tile:hover {
    border-color: var(--line-2);
  }
  .art {
    aspect-ratio: 16 / 10.4;
    border-radius: 9px;
    overflow: hidden;
    background: #000;
  }
  [data-theme='light'] .art {
    background: var(--soft);
  }
  img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.5s var(--ease);
  }
  .tile:hover img {
    transform: scale(1.03);
  }
  p {
    margin-top: 6px;
    padding: 0 4px;
    font-size: var(--small);
    font-weight: 500;
    line-height: 1.43;
  }
  @media (max-width: 620px) {
    .tiles {
      grid-template-columns: minmax(0, 1fr);
    }
  }
</style>
